 description = Cleaning

build build.ninja: REGENERATE_BUILD ../meson.build /Users/brooks/Documents/agentprojects/饭袋/OpenMinis/deps/ish/meson_options.txt ../vdso/arm64/meson.build ../vdso/arm64/check-cc-arm64.sh /opt/homebrew/Cellar/llvm/22.1.8/bin/clang-22 ../deps/meson.build ../tools/meson.build /Users/brooks/Documents/agentprojects/饭袋/OpenMinis/deps/ish/build-ios/ios-cross.txt meson-private/coredata.dat
 pool = console

build reconfigure: REGENERATE_BUILD PHONY
 pool = console

